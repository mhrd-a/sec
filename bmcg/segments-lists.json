{
    "questionnaire-section\" class=\"bg-white rounded-xl shadow-lg p-6\">\n                <h2 class=\"text-2xl font-semibold text-gray-800 mb-6\">Business Model Questionnaire</h2>\n                \n                <!-- Progress Bar -->\n                <div class=\"w-full bg-gray-200 rounded-full h-2.5 mb-6\">\n                    <div id=\"progress-bar\" class=\"bg-purple-600 h-2.5 rounded-full\" style=\"width: 0%\"></div>\n                </div>\n                \n                <!-- Steps Navigation -->\n                <div class=\"flex flex-wrap gap-2 mb-8\">\n                    <button data-step=\"1\" class=\"step-btn active-step flex items-center bg-purple-50 px-3 py-2 rounded-lg\">\n                        <div class=\"step-indicator\">1</div>\n                        <span class=\"step-title\">Basics</span>\n                    </button>\n                    <button data-step=\"2\" class=\"step-btn flex items-center bg-purple-50 px-3 py-2 rounded-lg\">\n                        <div class=\"step-indicator\">2</div>\n                        <span class=\"step-title\">Customer</span>\n                    </button>\n                    <button data-step=\"3\" class=\"step-btn flex items-center bg-purple-50 px-3 py-2 rounded-lg\">\n                        <div class=\"step-indicator\">3</div>\n                        <span class=\"step-title\">Offer</span>\n                    </button>\n                    <button data-step=\"4\" class=\"step-btn flex items-center bg-purple-50 px-3 py-2 rounded-lg\">\n                        <div class=\"step-indicator\">4</div>\n                        <span class=\"step-title\">Infrastructure</span>\n                    </button>\n                    <button data-step=\"5\" class=\"step-btn flex items-center bg-purple-50 px-3 py-2 rounded-lg\">\n                        <div class=\"step-indicator\">5</div>\n                        <span class=\"step-title\">Finances</span>\n                    </button>\n                </div>\n                \n                <form id=\"business-model-form\">\n                    <!-- Step 1: Basic Information -->\n                    <div id=\"step-1\" class=\"step-content\">\n                        <h3 class=\"text-xl font-medium text-gray-800 mb-4\">Basic Information</h3>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"business-name\" class=\"block text-gray-700 font-medium mb-2\">Business Name</label>\n                            <input type=\"text\" id=\"business-name": [
        "Young Adults (18-25)",
        "Adults (26-40)",
        "Middle-aged (41-60)",
        "Seniors (60+)",
        "Parents",
        "Students",
        "Professionals",
        "Small Businesses",
        "Enterprises",
        "Government",
        "Non-profits",
        "High-income Individuals",
        "Budget-conscious Consumers",
        "Tech Enthusiasts",
        "Health-conscious Individuals",
        "Other"
    ],
    "customer-segments-other\" class=\"other-input mt-3\">\n                                <textarea id=\"customer-segments-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other customer segments\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"customer-relationships\" class=\"block text-gray-700 font-medium mb-2\">Customer Relationships</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">How will you establish and maintain relationships with each customer segment?</p>\n                            <select id=\"customer-relationships": [
        "Self-service",
        "Automated Services",
        "Personal Assistance",
        "Dedicated Personal Assistance",
        "Communities",
        "Co-creation",
        "Subscription Services",
        "Loyalty Programs",
        "24/7 Support",
        "Social Media Engagement",
        "Email Marketing",
        "Content Marketing",
        "Other"
    ],
    "customer-relationships-other\" class=\"other-input mt-3\">\n                                <textarea id=\"customer-relationships-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other customer relationships\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"channels\" class=\"block text-gray-700 font-medium mb-2\">Channels</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">How will you reach and deliver value to your customers?</p>\n                            <select id=\"channels": [
        "Website",
        "Mobile App",
        "Physical Store",
        "Social Media",
        "Email",
        "Direct Sales",
        "Partner Stores",
        "Wholesalers",
        "Distributors",
        "E-commerce Platforms",
        "Events & Trade Shows",
        "Phone/Call Center",
        "Affiliate Marketing",
        "Other"
    ],
    "channels-other\" class=\"other-input mt-3\">\n                                <textarea id=\"channels-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other channels\"></textarea>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Step 3: Value Propositions -->\n                    <div id=\"step-3\" class=\"step-content hidden\">\n                        <h3 class=\"text-xl font-medium text-gray-800 mb-4\">Value Proposition</h3>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"value-propositions\" class=\"block text-gray-700 font-medium mb-2\">Value Propositions</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">What value do you deliver to customers? What problems are you solving?</p>\n                            <select id=\"value-propositions": [
        "Newness",
        "Performance",
        "Customization",
        "Design",
        "Brand/Status",
        "Price",
        "Cost Reduction",
        "Risk Reduction",
        "Accessibility",
        "Convenience",
        "Time Saving",
        "Sustainability",
        "Social Impact",
        "Other"
    ],
    "value-propositions-other\" class=\"other-input mt-3\">\n                                <textarea id=\"value-propositions-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other value propositions\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"unique-selling-point\" class=\"block text-gray-700 font-medium mb-2\">Unique Selling Point</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">What makes your offering different from competitors?</p>\n                            <select id=\"unique-selling-point": [
        "Proprietary Technology",
        "Patents",
        "Exclusive Features",
        "Superior Quality",
        "Best Price",
        "Customer Service",
        "Speed",
        "Expertise",
        "Location",
        "Personalization",
        "Ecosystem",
        "First Mover",
        "Other"
    ],
    "unique-selling-point-other\" class=\"other-input mt-3\">\n                                <textarea id=\"unique-selling-point-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other unique selling points\"></textarea>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Step 4: Key Resources, Activities, Partners -->\n                    <div id=\"step-4\" class=\"step-content hidden\">\n                        <h3 class=\"text-xl font-medium text-gray-800 mb-4\">Infrastructure</h3>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"key-resources\" class=\"block text-gray-700 font-medium mb-2\">Key Resources</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">What key assets are required to make your business model work?</p>\n                            <select id=\"key-resources": [
        "Physical Assets",
        "Intellectual Property",
        "Human Resources",
        "Financial Resources",
        "Technology",
        "Manufacturing Facilities",
        "Distribution Network",
        "Customer Base",
        "Brand",
        "Partnerships",
        "Natural Resources",
        "Other"
    ],
    "key-resources-other\" class=\"other-input mt-3\">\n                                <textarea id=\"key-resources-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other key resources\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"key-activities\" class=\"block text-gray-700 font-medium mb-2\">Key Activities</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">What key activities does your value proposition require?</p>\n                            <select id=\"key-activities": [
        "Production",
        "Problem Solving",
        "Platform/Network",
        "Supply Chain Management",
        "Research & Development",
        "Marketing & Sales",
        "Customer Support",
        "Content Creation",
        "Software Development",
        "Consulting",
        "Training",
        "Distribution",
        "Other"
    ],
    "key-activities-other\" class=\"other-input mt-3\">\n                                <textarea id=\"key-activities-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other key activities\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"key-partners\" class=\"block text-gray-700 font-medium mb-2\">Key Partners</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">Who are your key partners and suppliers?</p>\n                            <select id=\"key-partners": [
        "Suppliers",
        "Strategic Alliances",
        "Coopetition",
        "Joint Ventures",
        "Distributors",
        "Retailers",
        "Technology Partners",
        "Outsourcing Partners",
        "Investors",
        "Government",
        "Universities/Research Institutions",
        "Other"
    ],
    "key-partners-other\" class=\"other-input mt-3\">\n                                <textarea id=\"key-partners-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other key partners\"></textarea>\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Step 5: Revenue Streams, Cost Structure -->\n                    <div id=\"step-5\" class=\"step-content hidden\">\n                        <h3 class=\"text-xl font-medium text-gray-800 mb-4\">Financial Information</h3>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"revenue-streams\" class=\"block text-gray-700 font-medium mb-2\">Revenue Streams</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">How will your business generate revenue?</p>\n                            <select id=\"revenue-streams": [
        "Asset Sale",
        "Usage Fee",
        "Subscription Fees",
        "Lending/Renting/Leasing",
        "Licensing",
        "Brokerage Fees",
        "Advertising",
        "Freemium",
        "Commission",
        "Transaction Fees",
        "Data Sales",
        "Franchise",
        "Other"
    ],
    "revenue-streams-other\" class=\"other-input mt-3\">\n                                <textarea id=\"revenue-streams-other-input\" class=\"w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500 focus:border-purple-500 outline-none\" placeholder=\"Please specify other revenue streams\"></textarea>\n                            </div>\n                        </div>\n                        \n                        <div class=\"mb-6\">\n                            <label for=\"cost-structure\" class=\"block text-gray-700 font-medium mb-2\">Cost Structure</label>\n                            <p class=\"text-sm text-gray-500 mb-2\">What are the most important costs in your business model?</p>\n                            <select id=\"cost-structure": [
        "Fixed Costs",
        "Variable Costs",
        "Economies of Scale",
        "Economies of Scope",
        "R&D",
        "Manufacturing",
        "Marketing & Sales",
        "Customer Service",
        "Technology Infrastructure",
        "Logistics & Distribution",
        "Human Resources",
        "Other"
    ]
}